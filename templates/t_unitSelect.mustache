<div class="lpUnitSelect">
    <select class="lpUnit lpInvisible">
        {{#units}}
            <option value="{{unit}}" {{#selected}}selected{{/selected}}>{{unit}}</option>
        {{/units}}
    </select>

    <!--<input type="hidden" class="lpUnit" value="{{unit}}"/>-->
    {{#weight}}
    	<input type="hidden" class="lpMG" value="{{weight}}"/>
    {{/weight}}
    <span class="lpDisplay">{{unit}}</span>
    <i class="lpGlyph lpExpand"><svg class="lpIcon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"/></svg></i>
    <ul class="lpUnitDropdown">
        {{#units}}
            <li class="{{unit}}">{{unit}}</li>
        {{/units}}
    </ul>
</div>