<li class="lpItem {{classes}} {{#image}}lpItemHasImage{{/image}} {{#imageUrl}}lpItemHasImage{{/imageUrl}} {{#displayPrice}}lpItemHasPrice{{/displayPrice}}" id="{{id}}">
    {{#showImages}}
        <span class="lpImageCell">
            {{#image}}
                <img class="lpItemImage" src="https://i.imgur.com/{{image}}s.jpg" href="https://i.imgur.com/{{image}}l.jpg"/>
            {{/image}}
            {{^image}}
                {{#imageUrl}}
                    <img class="lpItemImage" src="{{imageUrl}}" href="{{imageUrl}}" />
                {{/imageUrl}}
            {{/image}}
        </span>
    {{/showImages}}
    <span class="lpName">
        {{#showLinks}}{{#url}}
            <a href="{{url}}" class="lpHref">
        {{/url}}{{/showLinks}}

        {{name}}

        {{#showLinks}}{{#url}}
            </a>
        {{/url}}{{/showLinks}}
    </span>
    <span class="lpDescription">
        {{description}}
    </span>
    <span class="lpActionsCell">
        <i class="lpWorn {{#worn}}lpActive{{/worn}} {{wornClass}}" title="This item is worn and not counted in pack weight."><svg class="lpIcon" width="16" height="16" viewBox="0 0 24 24" fill="{{#worn}}currentColor{{/worn}}{{^worn}}none{{/worn}}" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg></i>
        <i class="lpConsumable {{#consumable}}lpActive{{/consumable}} {{consumableClass}}" title="This item is a consumable and not counted in pack weight."><svg class="lpIcon" width="16" height="16" viewBox="0 0 24 24" fill="{{#consumable}}currentColor{{/consumable}}{{^consumable}}none{{/consumable}}" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg></i>
        <i class="lpStar {{starClass}} {{^starClass}}lpHidden{{/starClass}}" title="This item is starred"></i>
    </span>
    {{#showPrices}}
        <span class="lpPriceCell lpNumber">
            {{displayPrice}}
        </span>
    {{/showPrices}}
    <span class="lpWeightCell lpNumber">
        <span class="lpWeight">{{displayWeight}}</span>
        {{{unitSelect}}}
    </span>
    <span class="lpQtyCell lpNumber" qty{{qty}}>
        {{qty}}
    </span>
</li>
